<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>c847934a-828c-4ebb-a004-b0e97c8313f4</ProjectGuid>
    
    <Platforms>x86;x64;arm64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <PackageName>LibreWPF.Transport$(TransportPackageNameSuffix)</PackageName>
    <AssemblyName>$(PackageName)</AssemblyName>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.18</VersionSuffix>
    <Version>$(VersionPrefix)-$(VersionSuffix)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <PackageDescription>LibreWPF transport package for the portable managed presentation assemblies from the ProGPU port.</PackageDescription>
    <PackageReleaseNotes>Aligns LibreWPF with ProGPU preview.18; keeps menu, context-menu, ComboBox, and direct-popup pointer transfers interactive across native popup windows; synchronizes popup closure and native title chrome; enables runtime Aero, Aero2, AeroLite, Classic, Fluent, Luna, and Royale switching in the MVP sample; restores text selection, keyboard shortcuts, safe drag selection, and resize-time rendering; and retains the memory and glyph-atlas optimizations from preview.17.</PackageReleaseNotes>
    <PackageTags>librewpf;progpu;xaml;themes;transport</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackagingContent Include="README.md" SubFolder="root" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
