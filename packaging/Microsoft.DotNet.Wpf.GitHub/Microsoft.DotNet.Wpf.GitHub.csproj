<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>c847934a-828c-4ebb-a004-b0e97c8313f4</ProjectGuid>
    
    <Platforms>x86;x64;arm64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <PackageName>LibreWPF.Transport$(TransportPackageNameSuffix)</PackageName>
    <AssemblyName>$(PackageName)</AssemblyName>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.37</VersionSuffix>
    <Version>$(VersionPrefix)-$(VersionSuffix)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <PackageDescription>LibreWPF transport package for the portable managed presentation assemblies from the ProGPU port.</PackageDescription>
    <PackageReleaseNotes>Consumes ProGPU preview.43 retained canvas-state routing and typed bitmap-flush clip rebasing; bounds bitmap, shader-sampler, viewport, custom-font, and visual-replay retention with typed CPU/GPU ownership diagnostics; releases retained scene ownership on disposal; suppresses idle static-frame rendering; preserves nonactivating window state and settled popup placement; and retains alpha-capable X11 transparent windows and native Cocoa popups.</PackageReleaseNotes>
    <PackageTags>librewpf;progpu;xaml;themes;transport</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackagingContent Include="README.md" SubFolder="root" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
