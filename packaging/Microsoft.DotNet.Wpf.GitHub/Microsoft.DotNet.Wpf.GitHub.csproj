<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>c847934a-828c-4ebb-a004-b0e97c8313f4</ProjectGuid>
    
    <Platforms>x86;x64;arm64</Platforms>
  </PropertyGroup>

  <PropertyGroup>
    <PackageName>LibreWPF.Transport$(TransportPackageNameSuffix)</PackageName>
    <AssemblyName>$(PackageName)</AssemblyName>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.20</VersionSuffix>
    <Version>$(VersionPrefix)-$(VersionSuffix)</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <PackageDescription>LibreWPF transport package for the portable managed presentation assemblies from the ProGPU port.</PackageDescription>
    <PackageReleaseNotes>Aligns LibreWPF with ProGPU preview.20; prevents the Windows AnyCPU text access violation by keeping portable glyph runs off legacy native DirectWrite while retaining ProGPU replay; settles native popup placement after layout for WPF Gallery and SharpDevelop menus; preserves hosted double-click input for Project Explorer; keeps exact high-DPI logical sizing, native title chrome, resize-time rendering, text selection, keyboard shortcuts, and safe drag selection; and retains bounded GPU memory and glyph-atlas scrolling performance.</PackageReleaseNotes>
    <PackageTags>librewpf;progpu;xaml;themes;transport</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackagingContent Include="README.md" SubFolder="root" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
