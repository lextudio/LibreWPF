<Project>

  <!--
    Switches of the XAML Source Generator (XSG) path.

    BAML (PresentationBuildTasks) and XSG are two compile paths of which a project uses exactly one:

      UseLibreWpfXamlSourceGenerator   the overall switch. Off (default): the project is compiled by the BAML compiler, exactly
                                       as upstream WPF, and none of the feature switches below does anything.
                                       On: XAML is compiled by the generator.

    The feature switches belong to the XSG path. Each one follows the overall switch unless the project sets it explicitly,
    so `UseLibreWpfXamlSourceGenerator=true` alone turns every feature on and any feature can still be turned off:

      LibreWpfSimplerXaml              Simpler XAML: a root element without xmlns gets the default WPF presentation and `x`
                                       namespaces. Off: such a document is an error (LWXSG0003).
      LibreWpfCSharpExpressions        C# expressions: `{cs: <expression>}`. Off: a `{cs:}` value is an error (LWXSG0004).
      LibreWpfCompiledBindings         Compiled bindings: under an x:DataType a `{Binding Path}` is compiled to typed accessors
                                       (no reflection over the source; trim/NativeAOT safe) and a wrong path is a build error
                                       (LWXSG0005/0006). Off: every binding is the reflective stock Binding, x:DataType is ignored.

    The values reach the generator as build_property.<name> (CompilerVisibleProperty). A new feature is added here with one
    property, one CompilerVisibleProperty and one row in _LibreWpfXsgFeatureChecks.

    Nothing here writes anything the run time reads: System.Xaml, shared by every WPF program in a process, stays stock.
  -->

  <PropertyGroup>
    <UseLibreWpfXamlSourceGenerator Condition="'$(UseLibreWpfXamlSourceGenerator)' == ''">false</UseLibreWpfXamlSourceGenerator>

    <!-- What the project said itself, before the defaults below: used only to warn about a switch that cannot do anything. -->
    <_LibreWpfSimplerXamlExplicit>$(LibreWpfSimplerXaml)</_LibreWpfSimplerXamlExplicit>
    <_LibreWpfCSharpExpressionsExplicit>$(LibreWpfCSharpExpressions)</_LibreWpfCSharpExpressionsExplicit>
    <_LibreWpfCompiledBindingsExplicit>$(LibreWpfCompiledBindings)</_LibreWpfCompiledBindingsExplicit>

    <LibreWpfSimplerXaml Condition="'$(LibreWpfSimplerXaml)' == ''">$(UseLibreWpfXamlSourceGenerator)</LibreWpfSimplerXaml>
    <LibreWpfCSharpExpressions Condition="'$(LibreWpfCSharpExpressions)' == ''">$(UseLibreWpfXamlSourceGenerator)</LibreWpfCSharpExpressions>
    <LibreWpfCompiledBindings Condition="'$(LibreWpfCompiledBindings)' == ''">$(UseLibreWpfXamlSourceGenerator)</LibreWpfCompiledBindings>
  </PropertyGroup>

  <!--
    The generator itself. UseLibreWpfXamlSourceGenerator=true is enough: the SDK references the generator package, so a project (or an IDE that builds
    other people's projects) needs no PackageReference of its own. LibreWpfXsgAutoReference=false keeps the project's own reference (a locally built
    generator, a different version); a project that already references the package is left alone.

    One package serves C# and Visual Basic (it runs as a Roslyn generator in both). Languages whose compiler has no generators (F#) get their own
    package and an MSBuild task, selected here by $(Language) as they appear.
  -->
  <PropertyGroup>
    <LibreWpfXsgAutoReference Condition="'$(LibreWpfXsgAutoReference)' == ''">true</LibreWpfXsgAutoReference>
    <!-- The project file's extension, not $(Language): it is known before the language targets are imported. -->
    <_LibreWpfXsgGeneratorLanguage Condition="'$(MSBuildProjectExtension)' == '.csproj' Or '$(MSBuildProjectExtension)' == '.vbproj'">true</_LibreWpfXsgGeneratorLanguage>
  </PropertyGroup>

  <!-- The project's own reference, whatever the case of the id (Remove and Exclude compare item specs ignoring case). -->
  <ItemGroup>
    <_LibreWpfXsgProvider Include="@(PackageReference);@(ProjectReference->'%(Filename)');@(Analyzer->'%(Filename)')" />
    <_LibreWpfXsgOther Include="@(_LibreWpfXsgProvider)" />
    <_LibreWpfXsgOther Remove="LibreWPF.Xaml.SourceGenerator" />
    <_LibreWpfXsgExistingReference Include="@(_LibreWpfXsgProvider)" Exclude="@(_LibreWpfXsgOther)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLibreWpfXamlSourceGenerator)' == 'true' And '$(LibreWpfXsgAutoReference)' == 'true' And '$(_LibreWpfXsgGeneratorLanguage)' == 'true' And '@(_LibreWpfXsgExistingReference)' == '' And '$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="LibreWPF.Xaml.SourceGenerator" Version="$(ProGpuPackageVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLibreWpfXamlSourceGenerator)' == 'true' And '$(LibreWpfXsgAutoReference)' == 'true' And '$(_LibreWpfXsgGeneratorLanguage)' == 'true' And '@(_LibreWpfXsgExistingReference)' == '' And '$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="LibreWPF.Xaml.SourceGenerator" VersionOverride="$(ProGpuPackageVersion)" PrivateAssets="all" />
  </ItemGroup>

  <!--
    PresentationFramework.Aero, Aero2, AeroLite, Luna, Royale and Classic declare the same Microsoft.Windows.Themes types (BulletChrome, ButtonChrome,
    SystemDropShadowChrome, ...). The BAML compiler picks one through the assembly in the xmlns (`clr-namespace:Microsoft.Windows.Themes;assembly=
    PresentationFramework.Aero`); the generated C# names the type without any assembly, and with all of them referenced the compiler stops with CS0433.
    Under the generator, when Aero is referenced, only the Aero reference stays in the compile references (the others are still copied and loaded at run time).
    LibreWpfXsgKeepThemeReferences=true keeps them all, for a project that names them through an extern alias of its own.
  -->
  <Target Name="_LibreWpfXsgDropDuplicateThemeReferences"
          BeforeTargets="CoreCompile"
          Condition="'$(UseLibreWpfXamlSourceGenerator)' == 'true' And '$(LibreWpfXsgKeepThemeReferences)' != 'true'">
    <ItemGroup>
      <_LibreWpfXsgAeroReference Include="@(ReferencePathWithRefAssemblies)" Condition="'%(Filename)' == 'PresentationFramework.Aero'" />
      <_LibreWpfXsgAeroReference Include="@(ReferencePath)" Condition="'%(Filename)' == 'PresentationFramework.Aero'" />
    </ItemGroup>
    <!-- Only when Aero itself is referenced: a project that references just Aero2 or AeroLite keeps the types it has. -->
    <ItemGroup Condition="'@(_LibreWpfXsgAeroReference)' != ''">
      <_LibreWpfXsgThemeDuplicate Include="@(ReferencePathWithRefAssemblies);@(ReferencePath)"
                                  Condition="'%(Filename)' == 'PresentationFramework.Aero2' Or '%(Filename)' == 'PresentationFramework.AeroLite' Or '%(Filename)' == 'PresentationFramework.Luna' Or '%(Filename)' == 'PresentationFramework.Royale' Or '%(Filename)' == 'PresentationFramework.Classic'" />
      <!-- Both items: the compiler takes ReferencePathWithRefAssemblies, but tasks and analyzers that run before it read ReferencePath. -->
      <ReferencePathWithRefAssemblies Remove="@(_LibreWpfXsgThemeDuplicate)" />
      <ReferencePath Remove="@(_LibreWpfXsgThemeDuplicate)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <CompilerVisibleProperty Include="UseLibreWpfXamlSourceGenerator" />
    <CompilerVisibleProperty Include="LibreWpfSimplerXaml" />
    <CompilerVisibleProperty Include="LibreWpfCSharpExpressions" />
    <CompilerVisibleProperty Include="LibreWpfCompiledBindings" />
    <!-- XSG compiles every loose ResourceDictionary (themes included) to code; these give its resource path: project-relative, or the item's Link. -->
    <CompilerVisibleProperty Include="MSBuildProjectDirectory" />
    <!-- Optional: the assembly name loose dictionaries register under, for an XSG theme that stands in for another assembly
         (LibreWpfXsgResourceAssemblyName=PresentationFramework.Aero2). Empty: the compiling assembly's own name. -->
    <CompilerVisibleProperty Include="LibreWpfXsgResourceAssemblyName" />
    <!-- Optional: comma-separated types whose styles a generated theme leaves out (the document viewers where System.Printing is not available). -->
    <CompilerVisibleProperty Include="LibreWpfXsgExcludeTargetTypes" />
    <!-- Optional: LibreWpfLazyDictionaries=false builds every entry of a generated resource dictionary up front (default: each entry is created when first asked for). -->
    <CompilerVisibleProperty Include="LibreWpfLazyDictionaries" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Link" />
  </ItemGroup>

  <!-- A feature set to true while the overall switch is off does nothing (the BAML compiler has none of these features): say so. -->
  <Target Name="_LibreWpfXsgFeatureChecks"
          BeforeTargets="CoreCompile"
          Condition="'$(UseLibreWpfXamlSourceGenerator)' != 'true'">
    <Warning Code="LWXSG5001"
             Condition="'$(_LibreWpfSimplerXamlExplicit)' == 'true'"
             Text="LibreWpfSimplerXaml=true has no effect: Simpler XAML is a feature of the XAML source generator and UseLibreWpfXamlSourceGenerator is not enabled. The BAML compiler does not support it." />
    <Warning Code="LWXSG5001"
             Condition="'$(_LibreWpfCSharpExpressionsExplicit)' == 'true'"
             Text="LibreWpfCSharpExpressions=true has no effect: C# expressions are a feature of the XAML source generator and UseLibreWpfXamlSourceGenerator is not enabled. The BAML compiler does not support them." />
    <Warning Code="LWXSG5001"
             Condition="'$(_LibreWpfCompiledBindingsExplicit)' == 'true'"
             Text="LibreWpfCompiledBindings=true has no effect: compiled bindings are a feature of the XAML source generator and UseLibreWpfXamlSourceGenerator is not enabled. The BAML compiler does not support them." />
  </Target>

</Project>
