<Directives xmlns="http://schemas.microsoft.com/netfx/2013/01/metadata">
  <!--
    Internal types the in-box themes read by name, (base:AccessibilitySwitches.X) and (framework:FrameworkAppContextSwitches.X): the generated
    code finds their static properties by the type's name (__XsgStaticPath), so NativeAOT must keep them. (ListView.View / GridView.Columns, which
    the themes bind through TemplatedParent, no longer need a root: the generator compiles that path.)
  -->
  <Application>
    <Assembly Name="PresentationFramework">
      <!-- Read by the in-box themes as (framework:FrameworkAppContextSwitches.X) / (base:AccessibilitySwitches.X): internal, found by name. -->
      <Type Name="MS.Internal.FrameworkAppContextSwitches" Dynamic="Required All" />
    </Assembly>
    <Assembly Name="WindowsBase">
      <Type Name="System.Windows.AccessibilitySwitches" Dynamic="Required All" />
    </Assembly>
  </Application>
</Directives>
