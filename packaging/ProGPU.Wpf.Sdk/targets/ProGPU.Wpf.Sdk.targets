<Project>

  <PropertyGroup>
    <CopyLocalLockFileAssemblies Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true'">true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true'">
    <FrameworkReference Remove="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfEnablePortableBootstrap)' == 'true' And ('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe')">
    <Compile Include="$(MSBuildThisFileDirectory)ProGPU.Wpf.Sdk.PortableBootstrap.cs"
             Link="ProGPU.Wpf.Sdk.PortableBootstrap.cs"
             Visible="false" />
  </ItemGroup>

  <Target Name="_ProGpuWpfSdkRemoveWindowsDesktopPackageDownloads"
          BeforeTargets="CollectPackageDownloads"
          Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true'">
    <ItemGroup>
      <PackageDownload Remove="Microsoft.WindowsDesktop.App.Ref" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfReferenceMode)' == 'Package'">
    <PackageReference Include="$(ProGpuWpfManagedPackageId)" Version="$(ProGpuWpfManagedPackageVersion)" />
    <PackageReference Include="ProGPU.Wpf" Version="$(ProGpuWpfPackageVersion)" />
    <PackageReference Include="ProGPU.Backend" Version="$(ProGpuPackageVersion)" />
    <PackageReference Include="ProGPU.Scene" Version="$(ProGpuPackageVersion)" />
    <PackageReference Include="ProGPU.Vector" Version="$(ProGpuPackageVersion)" />
    <PackageReference Include="ProGPU.Text" Version="$(ProGpuPackageVersion)" />
    <PackageReference Include="ProGPU.Compute" Version="$(ProGpuPackageVersion)" />
    <PackageReference Include="ProGPU.Transpiler" Version="$(ProGpuPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfReferenceMode)' == 'LocalArtifacts' And '$(_ProGpuWpfManagedReferenceRoot)' != ''">
    <Reference Include="WindowsBase" HintPath="$(_ProGpuWpfManagedReferenceRoot)WindowsBase.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)WindowsBase.dll')" />
    <Reference Include="System.Xaml" HintPath="$(_ProGpuWpfManagedReferenceRoot)System.Xaml.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)System.Xaml.dll')" />
    <Reference Include="PresentationCore" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationCore.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationCore.dll')" />
    <Reference Include="PresentationFramework" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.dll')" />
    <Reference Include="PresentationUI" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationUI.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationUI.dll')" />
    <Reference Include="ReachFramework" HintPath="$(_ProGpuWpfManagedReferenceRoot)ReachFramework.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)ReachFramework.dll')" />
    <Reference Include="System.Printing" HintPath="$(_ProGpuWpfManagedReferenceRoot)System.Printing.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)System.Printing.dll')" />
    <Reference Include="UIAutomationTypes" HintPath="$(_ProGpuWpfManagedReferenceRoot)UIAutomationTypes.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)UIAutomationTypes.dll')" />
    <Reference Include="UIAutomationProvider" HintPath="$(_ProGpuWpfManagedReferenceRoot)UIAutomationProvider.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)UIAutomationProvider.dll')" />
    <Reference Include="System.Windows.Input.Manipulations" HintPath="$(_ProGpuWpfManagedReferenceRoot)System.Windows.Input.Manipulations.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)System.Windows.Input.Manipulations.dll')" />
    <Reference Include="System.Windows.Primitives" HintPath="$(_ProGpuWpfManagedReferenceRoot)System.Windows.Primitives.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)System.Windows.Primitives.dll')" />
    <Reference Include="PresentationFramework.Aero" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Aero.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Aero.dll')" />
    <Reference Include="PresentationFramework.Aero2" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Aero2.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Aero2.dll')" />
    <Reference Include="PresentationFramework.AeroLite" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.AeroLite.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.AeroLite.dll')" />
    <Reference Include="PresentationFramework.Classic" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Classic.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Classic.dll')" />
    <Reference Include="PresentationFramework.Fluent" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Fluent.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Fluent.dll')" />
    <Reference Include="PresentationFramework.Luna" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Luna.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Luna.dll')" />
    <Reference Include="PresentationFramework.Royale" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Royale.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Royale.dll')" />
  </ItemGroup>

  <ItemGroup Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfReferenceMode)' == 'LocalArtifacts' And '$(_ProGpuWpfManagedReferenceRoot)' != ''">
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)WindowsBase.dll" TargetPath="WindowsBase.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)WindowsBase.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)System.Xaml.dll" TargetPath="System.Xaml.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)System.Xaml.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)PresentationCore.dll" TargetPath="PresentationCore.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationCore.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.dll" TargetPath="PresentationFramework.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)PresentationUI.dll" TargetPath="PresentationUI.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationUI.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)ReachFramework.dll" TargetPath="ReachFramework.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)ReachFramework.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)System.Printing.dll" TargetPath="System.Printing.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)System.Printing.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)UIAutomationTypes.dll" TargetPath="UIAutomationTypes.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)UIAutomationTypes.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)UIAutomationProvider.dll" TargetPath="UIAutomationProvider.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)UIAutomationProvider.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)System.Windows.Input.Manipulations.dll" TargetPath="System.Windows.Input.Manipulations.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)System.Windows.Input.Manipulations.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)System.Windows.Primitives.dll" TargetPath="System.Windows.Primitives.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)System.Windows.Primitives.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Aero.dll" TargetPath="PresentationFramework.Aero.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Aero.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Aero2.dll" TargetPath="PresentationFramework.Aero2.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Aero2.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.AeroLite.dll" TargetPath="PresentationFramework.AeroLite.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.AeroLite.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Classic.dll" TargetPath="PresentationFramework.Classic.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Classic.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Fluent.dll" TargetPath="PresentationFramework.Fluent.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Fluent.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Luna.dll" TargetPath="PresentationFramework.Luna.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Luna.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Royale.dll" TargetPath="PresentationFramework.Royale.dll" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.Royale.dll')" />
  </ItemGroup>

  <ItemGroup Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfReferenceMode)' == 'LocalArtifacts' And '$(_ProGpuReferenceRoot)' != ''">
    <Reference Include="ProGPU.Wpf" HintPath="$(_ProGpuReferenceRoot)ProGPU.Wpf.dll" Private="true" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Wpf.dll')" />
    <Reference Include="ProGPU.Backend" HintPath="$(_ProGpuReferenceRoot)ProGPU.Backend.dll" Private="true" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Backend.dll')" />
    <Reference Include="ProGPU.Scene" HintPath="$(_ProGpuReferenceRoot)ProGPU.Scene.dll" Private="true" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Scene.dll')" />
    <Reference Include="ProGPU.Vector" HintPath="$(_ProGpuReferenceRoot)ProGPU.Vector.dll" Private="true" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Vector.dll')" />
    <Reference Include="ProGPU.Text" HintPath="$(_ProGpuReferenceRoot)ProGPU.Text.dll" Private="true" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Text.dll')" />
    <Reference Include="ProGPU.Compute" HintPath="$(_ProGpuReferenceRoot)ProGPU.Compute.dll" Private="true" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Compute.dll')" />
    <Reference Include="ProGPU.Transpiler" HintPath="$(_ProGpuReferenceRoot)ProGPU.Transpiler.dll" Private="true" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Transpiler.dll')" />
  </ItemGroup>

  <ItemGroup Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfReferenceMode)' == 'LocalArtifacts' And '$(_ProGpuReferenceRoot)' != ''">
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuReferenceRoot)ProGPU.Wpf.dll" TargetPath="ProGPU.Wpf.dll" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Wpf.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuReferenceRoot)ProGPU.Backend.dll" TargetPath="ProGPU.Backend.dll" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Backend.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuReferenceRoot)ProGPU.Scene.dll" TargetPath="ProGPU.Scene.dll" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Scene.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuReferenceRoot)ProGPU.Vector.dll" TargetPath="ProGPU.Vector.dll" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Vector.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuReferenceRoot)ProGPU.Text.dll" TargetPath="ProGPU.Text.dll" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Text.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuReferenceRoot)ProGPU.Compute.dll" TargetPath="ProGPU.Compute.dll" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Compute.dll')" />
    <_ProGpuWpfLocalRuntimeAsset Include="$(_ProGpuReferenceRoot)ProGPU.Transpiler.dll" TargetPath="ProGPU.Transpiler.dll" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Transpiler.dll')" />
  </ItemGroup>

  <Target Name="_ProGpuWpfSdkValidatePortableReferences"
          BeforeTargets="ResolveReferences"
          Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfReferenceMode)' == 'LocalArtifacts'">
    <Error Condition="'$(ProGpuWpfManagedReferenceRoot)' == ''"
           Text="ProGPU.Wpf.Sdk local artifact mode requires ProGpuWpfManagedReferenceRoot to point at the ported WPF assembly directory." />
    <Error Condition="'$(ProGpuReferenceRoot)' == ''"
           Text="ProGPU.Wpf.Sdk local artifact mode requires ProGpuReferenceRoot to point at the ProGPU assembly directory." />
  </Target>

  <Target Name="_ProGpuWpfSdkReportConfiguration"
          BeforeTargets="PrepareForBuild"
          Condition="'$(ProGpuWpfEnableSdkDiagnostics)' == 'true'">
    <Message Importance="High" Text="ProGPU.Wpf.Sdk platform=$(ProGpuWpfPlatform) backend=$(ProGpuWpfRenderingBackend) referenceMode=$(ProGpuWpfReferenceMode)" />
  </Target>

  <Target Name="_ProGpuWpfSdkCopyLocalRuntimeAssets"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfReferenceMode)' == 'LocalArtifacts' And '@(_ProGpuWpfLocalRuntimeAsset)' != ''">
    <Copy SourceFiles="@(_ProGpuWpfLocalRuntimeAsset)"
          DestinationFiles="@(_ProGpuWpfLocalRuntimeAsset->'$(TargetDir)%(TargetPath)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="_ProGpuWpfSdkClearMutablePackageOutputs"
          BeforeTargets="_ProGpuWpfSdkCopyPackageRuntimeAssets"
          Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfReferenceMode)' == 'Package' And '$(ProGpuWpfClearMutablePackageOutputs)' == 'true'">
    <ItemGroup>
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)WindowsBase.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)System.Xaml.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)PresentationCore.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)PresentationFramework.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)PresentationUI.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)ReachFramework.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)UIAutomationTypes.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)UIAutomationProvider.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)System.Windows.Input.Manipulations.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)System.Windows.Primitives.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)PresentationFramework.Aero.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)PresentationFramework.Aero2.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)PresentationFramework.AeroLite.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)PresentationFramework.Classic.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)PresentationFramework.Fluent.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)PresentationFramework.Luna.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)PresentationFramework.Royale.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)ProGPU.Wpf.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)ProGPU.Backend.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)ProGPU.Scene.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)ProGPU.Vector.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)ProGPU.Text.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)ProGPU.Compute.dll" />
      <_ProGpuWpfSdkMutablePackageOutput Include="$(TargetDir)ProGPU.Transpiler.dll" />
      <_ProGpuWpfSdkExistingMutablePackageOutput
        Include="@(_ProGpuWpfSdkMutablePackageOutput)"
        Condition="Exists('%(_ProGpuWpfSdkMutablePackageOutput.Identity)')" />
    </ItemGroup>

    <Delete Files="@(_ProGpuWpfSdkExistingMutablePackageOutput)" />
  </Target>

  <Target Name="_ProGpuWpfSdkCopyPackageRuntimeAssets"
          DependsOnTargets="ResolveLockFileCopyLocalFiles"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '@(RuntimeCopyLocalItems)' != ''">
    <Copy SourceFiles="@(RuntimeCopyLocalItems)"
          DestinationFiles="@(RuntimeCopyLocalItems->'$(TargetDir)%(DestinationSubDirectory)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="_ProGpuWpfSdkCopyNativeRuntimeAssets"
          DependsOnTargets="ResolvePackageAssets"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '@(NativeCopyLocalItems)' != ''">
    <Copy SourceFiles="@(NativeCopyLocalItems)"
          DestinationFiles="@(NativeCopyLocalItems->'$(TargetDir)%(DestinationSubPath)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
