<Project>

  <ItemGroup Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true'">
    <FrameworkReference Remove="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <Target Name="_ProGpuWpfSdkRemoveWindowsDesktopPackageDownloads"
          BeforeTargets="CollectPackageDownloads"
          Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true'">
    <ItemGroup>
      <PackageDownload Remove="Microsoft.WindowsDesktop.App.Ref" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfReferenceMode)' == 'Package'">
    <PackageReference Include="ProGPU.Wpf" Version="$(ProGpuWpfPackageVersion)" />
    <PackageReference Include="ProGPU.Backend" Version="$(ProGpuPackageVersion)" />
    <PackageReference Include="ProGPU.Scene" Version="$(ProGpuPackageVersion)" />
    <PackageReference Include="ProGPU.Vector" Version="$(ProGpuPackageVersion)" />
    <PackageReference Include="ProGPU.Text" Version="$(ProGpuPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfReferenceMode)' == 'LocalArtifacts' And '$(_ProGpuWpfManagedReferenceRoot)' != ''">
    <Reference Include="WindowsBase" HintPath="$(_ProGpuWpfManagedReferenceRoot)WindowsBase.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)WindowsBase.dll')" />
    <Reference Include="System.Xaml" HintPath="$(_ProGpuWpfManagedReferenceRoot)System.Xaml.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)System.Xaml.dll')" />
    <Reference Include="PresentationCore" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationCore.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationCore.dll')" />
    <Reference Include="PresentationFramework" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationFramework.dll')" />
    <Reference Include="PresentationUI" HintPath="$(_ProGpuWpfManagedReferenceRoot)PresentationUI.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)PresentationUI.dll')" />
    <Reference Include="ReachFramework" HintPath="$(_ProGpuWpfManagedReferenceRoot)ReachFramework.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)ReachFramework.dll')" />
    <Reference Include="System.Printing" HintPath="$(_ProGpuWpfManagedReferenceRoot)System.Printing.dll" Private="true" Condition="Exists('$(_ProGpuWpfManagedReferenceRoot)System.Printing.dll')" />
  </ItemGroup>

  <ItemGroup Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfReferenceMode)' == 'LocalArtifacts' And '$(_ProGpuReferenceRoot)' != ''">
    <Reference Include="ProGPU.Wpf" HintPath="$(_ProGpuReferenceRoot)ProGPU.Wpf.dll" Private="true" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Wpf.dll')" />
    <Reference Include="ProGPU.Backend" HintPath="$(_ProGpuReferenceRoot)ProGPU.Backend.dll" Private="true" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Backend.dll')" />
    <Reference Include="ProGPU.Scene" HintPath="$(_ProGpuReferenceRoot)ProGPU.Scene.dll" Private="true" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Scene.dll')" />
    <Reference Include="ProGPU.Vector" HintPath="$(_ProGpuReferenceRoot)ProGPU.Vector.dll" Private="true" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Vector.dll')" />
    <Reference Include="ProGPU.Text" HintPath="$(_ProGpuReferenceRoot)ProGPU.Text.dll" Private="true" Condition="Exists('$(_ProGpuReferenceRoot)ProGPU.Text.dll')" />
  </ItemGroup>

  <Target Name="_ProGpuWpfSdkValidatePortableReferences"
          BeforeTargets="ResolveReferences"
          Condition="'$(ProGpuWpfUsePortableFrameworkReferences)' == 'true' And '$(ProGpuWpfReferenceMode)' == 'LocalArtifacts'">
    <Error Condition="'$(ProGpuWpfManagedReferenceRoot)' == ''"
           Text="ProGPU.Wpf.Sdk local artifact mode requires ProGpuWpfManagedReferenceRoot to point at the ported WPF assembly directory." />
    <Error Condition="'$(ProGpuReferenceRoot)' == ''"
           Text="ProGPU.Wpf.Sdk local artifact mode requires ProGpuReferenceRoot to point at the ProGPU assembly directory." />
  </Target>

  <Target Name="_ProGpuWpfSdkReportConfiguration"
          BeforeTargets="PrepareForBuild"
          Condition="'$(ProGpuWpfEnableSdkDiagnostics)' == 'true'">
    <Message Importance="High" Text="ProGPU.Wpf.Sdk platform=$(ProGpuWpfPlatform) backend=$(ProGpuWpfRenderingBackend) referenceMode=$(ProGpuWpfReferenceMode)" />
  </Target>

</Project>
