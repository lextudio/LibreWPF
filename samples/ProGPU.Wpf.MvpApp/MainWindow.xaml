<Window
    x:Class="ProGPU.Wpf.MvpApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:local="clr-namespace:ProGPU.Wpf.MvpApp"
    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
    x:Name="RootWindow"
    Title="ProGPU WPF MVP"
    Width="760"
    Height="560"
    MinWidth="560"
    MinHeight="420">
    <Window.CommandBindings>
        <CommandBinding
            Command="{x:Static local:MainWindow.RefreshStatusCommand}"
            CanExecute="OnRefreshStatusCommandCanExecute"
            Executed="OnRefreshStatusCommandExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding
            Key="R"
            Modifiers="Control"
            Command="{x:Static local:MainWindow.RefreshStatusCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <local:MvpActiveTextConverter x:Key="MvpActiveTextConverter" />
        <local:MvpItemSummaryConverter x:Key="MvpItemSummaryConverter" />
        <DataTemplate
            x:Key="MvpActiveItemTemplate"
            DataType="{x:Type local:MvpItem}">
            <Border
                MinWidth="150"
                Padding="8"
                Background="#E7F5EE">
                <StackPanel>
                    <TextBlock
                        x:Name="SelectorActiveNameText"
                        FontWeight="SemiBold"
                        Text="{Binding Name}" />
                    <TextBlock
                        Foreground="#236B46"
                        Text="Active item" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate
            x:Key="MvpInactiveItemTemplate"
            DataType="{x:Type local:MvpItem}">
            <Border
                MinWidth="150"
                Padding="8"
                Background="#F2F3F6">
                <StackPanel>
                    <TextBlock
                        x:Name="SelectorInactiveNameText"
                        FontWeight="SemiBold"
                        Text="{Binding Name}" />
                    <TextBlock
                        Foreground="#5B6472"
                        Text="Inactive item" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <local:MvpItemTemplateSelector
            x:Key="MvpItemTemplateSelector"
            ActiveTemplate="{StaticResource MvpActiveItemTemplate}"
            InactiveTemplate="{StaticResource MvpInactiveItemTemplate}" />
        <ControlTemplate x:Key="MvpValidationErrorTemplate">
            <StackPanel>
                <AdornedElementPlaceholder x:Name="MvpValidationErrorPlaceholder" />
                <TextBlock
                    x:Name="MvpValidationErrorText"
                    Margin="0,4,0,0"
                    Foreground="#B42318"
                    Text="{Binding [0].ErrorContent}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ControlTemplate>
        <Style
            x:Key="MvpSelectorItemContainerStyle"
            TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Tag" Value="ActiveContainer" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <CollectionViewSource
            x:Key="ItemsViewSource"
            Filter="OnItemsViewSourceFilter">
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription
                    Direction="Ascending"
                    PropertyName="Category" />
                <componentModel:SortDescription
                    Direction="Ascending"
                    PropertyName="Name" />
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <HierarchicalDataTemplate
            x:Key="MvpNodeTemplate"
            ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    MinWidth="130"
                    FontWeight="SemiBold"
                    Text="{Binding Name}" />
                <TextBlock
                    Foreground="#5B6472"
                    Text="{Binding Kind, StringFormat=Kind: {0}}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Menu
                x:Name="MainMenu"
                Margin="0,0,0,10">
                <MenuItem
                    x:Name="FileMenuItem"
                    Header="_File">
                    <MenuItem
                        x:Name="AddMenuItem"
                        Command="{Binding AddItemCommand}"
                        Header="_Add item"
                        InputGestureText="Ctrl+N" />
                    <Separator />
                    <MenuItem
                        x:Name="ResetMenuItem"
                        Command="{Binding ResetCommand}"
                        Header="_Reset" />
                    <Separator />
                    <MenuItem
                        x:Name="AboutMenuItem"
                        Click="OnAboutMenuItemClick"
                        Header="_About" />
                </MenuItem>
                <MenuItem
                    x:Name="ViewMenuItem"
                    Header="_View">
                    <MenuItem
                        x:Name="ActionsEnabledMenuItem"
                        Header="_Enable actions"
                        IsCheckable="True"
                        IsChecked="{Binding ActionsEnabled}" />
                    <Separator />
                    <MenuItem
                        x:Name="RefreshMenuItem"
                        Command="{x:Static local:MainWindow.RefreshStatusCommand}"
                        Header="_Refresh status"
                        InputGestureText="Ctrl+R" />
                </MenuItem>
            </Menu>
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="ProGPU WPF MVP" />
            <TextBlock
                Margin="0,4,0,14"
                Foreground="#5B6472"
                Text="A no-source-change SDK app using regular WPF XAML, bindings, commands, controls, and documents." />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Controls">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,14"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="NameTextBox"
                                VerticalContentAlignment="Center"
                                Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Command="{Binding AddItemCommand}"
                                Content="Add item" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ListBox
                            x:Name="ItemsList"
                            ItemsSource="{Binding Items}"
                            SelectedItem="{Binding SelectedItem}">
                            <ListBox.ContextMenu>
                                <ContextMenu
                                    x:Name="ItemsContextMenu"
                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem
                                        x:Name="ContextAddMenuItem"
                                        Command="{Binding AddItemCommand}"
                                        Header="_Add item" />
                                    <MenuItem
                                        x:Name="ContextRefreshMenuItem"
                                        Command="{x:Static local:MainWindow.RefreshStatusCommand}"
                                        CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                        Header="_Refresh status" />
                                    <Separator />
                                    <MenuItem
                                        x:Name="ContextActionsEnabledMenuItem"
                                        Header="_Enable actions"
                                        IsCheckable="True"
                                        IsChecked="{Binding ActionsEnabled}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="120"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Foreground="#5B6472"
                                            Text="{Binding Category, StringFormat=Category: {0}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,12,0,6"
                            FontWeight="SemiBold"
                            Text="Tabular view" />

                        <DataGrid
                            x:Name="ItemsDataGrid"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Items}"
                            SelectedItem="{Binding SelectedItem}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Binding="{Binding Name}"
                                    Header="Name" />
                                <DataGridTextColumn
                                    Binding="{Binding Category}"
                                    Header="Category" />
                                <DataGridCheckBoxColumn
                                    Binding="{Binding IsActive}"
                                    Header="Active" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="18,0,0,0">
                        <CheckBox
                            x:Name="EnabledCheckBox"
                            Margin="0,0,0,12"
                            Content="Enable actions"
                            IsChecked="{Binding ActionsEnabled}" />
                        <TextBlock Text="Progress" />
                        <Slider
                            x:Name="ProgressSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding Progress}" />
                        <ProgressBar
                            Height="16"
                            Margin="0,4,0,12"
                            Maximum="100"
                            Value="{Binding Progress}" />
                        <ComboBox
                            x:Name="CategoryCombo"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}" />
                        <Button
                            Margin="0,14,0,0"
                            Command="{Binding ResetCommand}"
                            Content="Reset" />
                        <local:SummaryPanel
                            x:Name="SummaryPanel"
                            Margin="0,18,0,0" />
                        <TextBlock
                            Margin="0,18,0,4"
                            FontWeight="SemiBold"
                            Text="Selected summary" />
                        <TextBlock
                            x:Name="SelectedItemSummaryText"
                            TextWrapping="Wrap">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource MvpItemSummaryConverter}">
                                    <Binding Path="SelectedItem.Name" />
                                    <Binding Path="SelectedItem.Category" />
                                    <Binding Path="Progress" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Views">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <CheckBox
                        x:Name="ActiveOnlyCheckBox"
                        Margin="0,0,0,12"
                        Checked="OnActiveOnlyFilterChanged"
                        Content="Show active items only"
                        IsChecked="{Binding ShowActiveOnly}"
                        Unchecked="OnActiveOnlyFilterChanged" />

                    <ListBox
                        x:Name="GroupedItemsList"
                        Grid.Row="1"
                        ItemsSource="{Binding Source={StaticResource ItemsViewSource}}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,8,0,4"
                                            Padding="6,3"
                                            Background="{DynamicResource MvpPanelBrush}">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        MinWidth="120"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        x:Name="GroupedItemActiveText"
                                        Foreground="#5B6472"
                                        Text="{Binding IsActive, Converter={StaticResource MvpActiveTextConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Collection view" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="CollectionViewSource sorting, grouping, filtering, and group header templates are loaded from compiled WPF XAML." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Bindings">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Binding fallback paths" />
                        <TextBlock
                            x:Name="PriorityBindingText"
                            Margin="0,0,0,8">
                            <TextBlock.Text>
                                <PriorityBinding FallbackValue="Priority fallback">
                                    <Binding Path="MissingPriorityText" />
                                    <Binding Path="SelectedItem.Name" />
                                </PriorityBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock
                            x:Name="FallbackBindingText"
                            Margin="0,0,0,8"
                            Text="{Binding MissingFallbackText, FallbackValue=Fallback binding text}" />
                        <TextBlock
                            x:Name="TargetNullBindingText"
                            Margin="0,0,0,8"
                            Text="{Binding NullDisplayText, TargetNullValue=Target null text}" />
                        <TextBlock
                            x:Name="RelativeSelfBindingText"
                            Margin="0,0,0,8"
                            Tag="Self binding text"
                            Text="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" />
                        <Border
                            x:Name="RelativeAncestorBorder"
                            Padding="8"
                            Background="{DynamicResource MvpPanelBrush}"
                            Tag="Ancestor binding text">
                            <TextBlock
                                x:Name="RelativeAncestorBindingText"
                                Text="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=Tag}" />
                        </Border>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Binding engine" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="This tab uses PriorityBinding, FallbackValue, TargetNullValue, and RelativeSource bindings through SDK-built BAML." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Selectors">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox
                        x:Name="SelectorGroupBox"
                        Header="Selector container">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="SemiBold"
                                Text="SelectedValue selector" />
                            <ComboBox
                                x:Name="SelectedValueComboBox"
                                Grid.Row="1"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Items}"
                                SelectedValue="{Binding SelectedCategory, Mode=TwoWay}"
                                SelectedValuePath="Category"
                                SelectionChanged="OnSelectorSelectionChanged" />

                            <ListBox
                                x:Name="MultiSelectItemsList"
                                Grid.Row="2"
                                Margin="0,14,0,0"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Items}"
                                SelectionChanged="OnMultiSelectorSelectionChanged"
                                SelectionMode="Multiple" />
                        </Grid>
                    </GroupBox>

                    <Expander
                        x:Name="SelectorExpander"
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Collapsed="OnSelectorExpanderCollapsed"
                        Expanded="OnSelectorExpanderExpanded"
                        Header="Scrollable details"
                        IsExpanded="False">
                        <ScrollViewer
                            x:Name="SelectorScrollViewer"
                            Height="160"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock
                                    x:Name="SelectorScrollText"
                                    TextWrapping="Wrap"
                                    Text="This selector surface uses SelectedValuePath, multi-selection, GroupBox, Expander, and ScrollViewer from ordinary WPF XAML." />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    Text="{Binding StatusText}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="Input">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ToolBarTray
                        x:Name="MvpToolBarTray"
                        Grid.ColumnSpan="2">
                        <ToolBar
                            x:Name="MvpToolBar"
                            Header="MVP tools">
                            <Button
                                x:Name="ToolBarRefreshButton"
                                Command="{x:Static local:MainWindow.RefreshStatusCommand}"
                                Content="Refresh">
                                <Button.ToolTip>
                                    <ToolTip
                                        x:Name="ToolBarRefreshToolTip"
                                        Placement="Bottom">
                                        <TextBlock
                                            x:Name="ToolBarRefreshToolTipText"
                                            Text="Refresh status command" />
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                            <Separator x:Name="ToolBarSeparator" />
                            <ToggleButton
                                x:Name="ToolBarToggleButton"
                                Checked="OnInputToggleChecked"
                                Content="Actions"
                                IsChecked="{Binding ActionsEnabled, Mode=TwoWay}"
                                Unchecked="OnInputToggleUnchecked" />
                        </ToolBar>
                    </ToolBarTray>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Choice controls" />
                        <Button
                            x:Name="PopupOwnerButton"
                            Content="Popup owner" />
                        <primitives:Popup
                            x:Name="InputPopup"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=PopupOwnerButton}"
                            StaysOpen="False">
                            <Border
                                Padding="10"
                                Background="{DynamicResource MvpPanelBrush}"
                                BorderBrush="#B7C2D0"
                                BorderThickness="1">
                                <TextBlock
                                    x:Name="InputPopupText"
                                    Text="Popup content" />
                            </Border>
                        </primitives:Popup>
                        <ToggleButton
                            x:Name="InputToggleButton"
                            Margin="0,12,0,0"
                            Checked="OnInputToggleChecked"
                            Content="Enable actions"
                            IsChecked="{Binding ActionsEnabled, Mode=TwoWay}"
                            Unchecked="OnInputToggleUnchecked" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <RadioButton
                                x:Name="FrameworkRadioButton"
                                GroupName="MvpCategory"
                                Checked="OnCategoryRadioChecked"
                                Content="Framework"
                                IsChecked="True"
                                Tag="Framework" />
                            <RadioButton
                                x:Name="RenderingRadioButton"
                                Margin="14,0,0,0"
                                GroupName="MvpCategory"
                                Checked="OnCategoryRadioChecked"
                                Content="Rendering"
                                Tag="Rendering" />
                        </StackPanel>
                        <RepeatButton
                            x:Name="InputRepeatButton"
                            Margin="0,14,0,0"
                            Click="OnInputRepeatButtonClick"
                            Content="Repeat action"
                            Delay="180"
                            Interval="70" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="18,14,0,0">
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Date controls" />
                        <Calendar
                            x:Name="InputCalendar"
                            SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedDatesChanged="OnInputDateSelectionChanged"
                            SelectionMode="SingleDate" />
                        <DatePicker
                            x:Name="InputDatePicker"
                            Margin="0,12,0,0"
                            SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedDateChanged="OnInputDateSelectionChanged" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Layout">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel
                        x:Name="MvpDockPanel"
                        MinHeight="92"
                        LastChildFill="True">
                        <Border
                            x:Name="DockTopBand"
                            DockPanel.Dock="Top"
                            Padding="8"
                            Background="{DynamicResource MvpPanelBrush}">
                            <TextBlock Text="Docked header" />
                        </Border>
                        <Border
                            x:Name="DockLeftBand"
                            Width="92"
                            DockPanel.Dock="Left"
                            Padding="8"
                            Background="#E7F5EE">
                            <TextBlock Text="Left dock" />
                        </Border>
                        <Border
                            x:Name="DockRightBand"
                            Width="92"
                            DockPanel.Dock="Right"
                            Padding="8"
                            Background="#F2F3F6">
                            <TextBlock Text="Right dock" />
                        </Border>
                        <TextBlock
                            x:Name="DockFillText"
                            Padding="8"
                            Text="Fill content" />
                    </DockPanel>

                    <WrapPanel
                        x:Name="MvpWrapPanel"
                        Grid.Row="1"
                        Margin="0,14,0,0"
                        ItemHeight="28"
                        ItemWidth="90"
                        Orientation="Horizontal">
                        <Button Content="One" />
                        <Button Content="Two" />
                        <Button Content="Three" />
                    </WrapPanel>

                    <UniformGrid
                        x:Name="MvpUniformGrid"
                        Grid.Row="2"
                        Margin="0,14,0,0"
                        Columns="3"
                        FirstColumn="1"
                        Rows="2">
                        <TextBlock Text="Alpha" />
                        <TextBlock Text="Beta" />
                        <TextBlock Text="Gamma" />
                    </UniformGrid>

                    <Grid
                        x:Name="MvpGridSplitterGrid"
                        Grid.Column="1"
                        Grid.RowSpan="3"
                        Margin="18,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                x:Name="SplitterLeftColumn"
                                Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition
                                x:Name="SplitterRightColumn"
                                Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="SplitterLeftPane"
                            Padding="8"
                            Background="{DynamicResource MvpPanelBrush}">
                            <TextBlock Text="Left pane" />
                        </Border>
                        <GridSplitter
                            x:Name="MvpGridSplitter"
                            Grid.Column="1"
                            Width="6"
                            HorizontalAlignment="Stretch"
                            KeyboardIncrement="12"
                            ResizeBehavior="PreviousAndNext"
                            ShowsPreview="False"
                            VerticalAlignment="Stretch" />
                        <Border
                            x:Name="SplitterRightPane"
                            Grid.Column="2"
                            Padding="8"
                            Background="#F2F3F6">
                            <TextBlock Text="Right pane" />
                        </Border>

                        <Viewbox
                            x:Name="MvpViewbox"
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Margin="0,14,0,0"
                            MaxHeight="54"
                            Stretch="Uniform">
                            <TextBlock
                                x:Name="ViewboxText"
                                FontSize="20"
                                Text="Scaled layout content" />
                        </Viewbox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Resources">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            x:Name="ComponentResourceText"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource {ComponentResourceKey TypeInTargetAssembly={x:Type local:MainWindow}, ResourceId=MvpComponentAccentBrush}}"
                            Text="Component resource brush" />
                        <TextBlock
                            x:Name="LocalizedResourceText"
                            x:Uid="MvpLocalizedResourceText"
                            Margin="0,12,0,0"
                            Localization.Attributes="$Text (Readable Modifiable Text)"
                            Localization.Comments="$Text (MVP localization comment)"
                            Text="Localized resource metadata" />
                        <AccessText
                            x:Name="ResourceAccessText"
                            Margin="0,12,0,0"
                            Text="_Resource access key" />
                        <TextBlock
                            x:Name="PackResourceText"
                            Margin="0,12,0,0"
                            Text="Pack resource loaded from Assets/MvpResource.txt" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Resources" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="This tab uses ComponentResourceKey, localization metadata, AccessText, and a WPF Resource pack URI through SDK-built output." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Explorer">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TreeView
                        x:Name="NodesTreeView"
                        ItemTemplate="{StaticResource MvpNodeTemplate}"
                        ItemsSource="{Binding Nodes}" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,12,0,8"
                        FontWeight="SemiBold"
                        Text="Grid view" />

                    <ListView
                        x:Name="ExplorerListView"
                        Grid.Row="2"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding SelectedItem}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn
                                    Width="150"
                                    DisplayMemberBinding="{Binding Name}"
                                    Header="Name" />
                                <GridViewColumn
                                    Width="130"
                                    DisplayMemberBinding="{Binding Category}"
                                    Header="Category" />
                                <GridViewColumn
                                    Width="80"
                                    DisplayMemberBinding="{Binding IsActive}"
                                    Header="Active" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border
                        Grid.Column="1"
                        Grid.RowSpan="3"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Hierarchy" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="TreeView, HierarchicalDataTemplate, ListView, and GridView are loaded from normal WPF XAML through the ProGPU SDK." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Templates">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ContentControl
                            x:Name="SelectedItemContent"
                            Content="{Binding SelectedItem}"
                            ContentTemplate="{StaticResource SelectedItemTemplate}" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,14,0,8"
                            FontWeight="SemiBold"
                            Text="Template selector list" />

                        <ListBox
                            x:Name="SelectorItemsList"
                            Grid.Row="2"
                            ItemContainerStyle="{StaticResource MvpSelectorItemContainerStyle}"
                            ItemTemplateSelector="{StaticResource MvpItemTemplateSelector}"
                            ItemsSource="{Binding Items}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Resource template" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="The selected item view is generated by a compiled DataTemplate, while the list below uses a DataTemplateSelector, ItemContainerStyle, and ItemsPanelTemplate." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Themes">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="ControlTemplate style" />
                        <Button
                            x:Name="TemplateButton"
                            Content="Templated action"
                            Style="{StaticResource MvpTemplateButtonStyle}" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Theme template" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="The button is styled through a compiled ControlTemplate, TemplateBinding, named parts, VisualStateManager states, and a property trigger." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Validation">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Validated form field" />
                        <TextBox
                            x:Name="ValidationTextBox"
                            Validation.ErrorTemplate="{StaticResource MvpValidationErrorTemplate}">
                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    NotifyOnValidationError="True"
                                    Path="ValidationText"
                                    UpdateSourceTrigger="Explicit">
                                    <Binding.ValidationRules>
                                        <local:MvpNonEmptyValidationRule />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock
                            x:Name="ValidationEchoText"
                            Margin="0,14,0,0"
                            Text="{Binding ValidationText, StringFormat=Current: {0}}"
                            TextWrapping="Wrap" />
                        <Separator Margin="0,18,0,14" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Grouped commit validation" />
                        <StackPanel x:Name="BindingGroupPanel">
                            <StackPanel.BindingGroup>
                                <BindingGroup Name="MvpBindingGroup">
                                    <BindingGroup.ValidationRules>
                                        <local:MvpBindingGroupValidationRule
                                            FirstProperty="BindingGroupFirstName"
                                            RequiredPrefix="group:"
                                            SecondProperty="BindingGroupLastName" />
                                    </BindingGroup.ValidationRules>
                                </BindingGroup>
                            </StackPanel.BindingGroup>
                            <TextBox
                                x:Name="BindingGroupFirstBox"
                                Text="{Binding BindingGroupFirstName, UpdateSourceTrigger=Explicit}" />
                            <TextBox
                                x:Name="BindingGroupLastBox"
                                Margin="0,8,0,0"
                                Text="{Binding BindingGroupLastName, UpdateSourceTrigger=Explicit}" />
                            <Button
                                x:Name="BindingGroupCommitButton"
                                Margin="0,10,0,0"
                                Click="OnBindingGroupCommitClick"
                                Content="Commit grouped edit" />
                            <TextBlock
                                x:Name="BindingGroupStatusText"
                                Margin="0,10,0,0"
                                Text="{Binding BindingGroupStatus}" />
                            <TextBlock
                                x:Name="BindingGroupFirstEchoText"
                                Margin="0,10,0,0"
                                Text="{Binding BindingGroupFirstName, StringFormat=First: {0}}" />
                            <TextBlock
                                x:Name="BindingGroupLastEchoText"
                                Text="{Binding BindingGroupLastName, StringFormat=Last: {0}}" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Binding validation" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="This tab uses a normal WPF ValidationRule, explicit source updates, and a compiled Validation.ErrorTemplate." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Animation">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Storyboard triggers" />
                        <TextBlock
                            x:Name="LoadedStoryboardText"
                            Opacity="1"
                            Text="Loaded storyboard target">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="LoadedStoryboardText"
                                                Storyboard.TargetProperty="Opacity"
                                                Duration="0:0:0"
                                                To="0.42" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                        <Button
                            x:Name="ClickStoryboardButton"
                            Margin="0,14,0,0"
                            Content="Animate click target"
                            Opacity="1">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ClickStoryboardButton"
                                                Storyboard.TargetProperty="Opacity"
                                                Duration="0:0:0"
                                                To="0.58" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="EventTrigger clocks" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="This tab uses compiled EventTrigger and BeginStoryboard timelines loaded through the ProGPU WPF SDK." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Navigation">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Frame
                        x:Name="NavigationFrame"
                        NavigationUIVisibility="Visible"
                        Source="OverviewPage.xaml" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="18,0,0,0">
                        <Button
                            x:Name="OverviewNavigationButton"
                            Content="Overview"
                            Click="OnOverviewNavigationClick" />
                        <Button
                            x:Name="DetailsNavigationButton"
                            Content="Details"
                            Click="OnDetailsNavigationClick" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Editing">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Password entry" />
                        <PasswordBox
                            x:Name="EditorPasswordBox"
                            MaxLength="16"
                            PasswordChanged="OnEditorPasswordChanged"
                            PasswordChar="*" />
                    </StackPanel>

                    <RichTextBox
                        x:Name="EditorRichTextBox"
                        Grid.Row="1"
                        Margin="0,16,0,0">
                        <FlowDocument PagePadding="6">
                            <Paragraph>
                                <Run Text="Editable plain text" />
                                <Bold>
                                    <Run Text="bold text" />
                                </Bold>
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>

                    <Border
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Text editing" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="This tab uses WPF PasswordBox, RichTextBox, FlowDocument, TextRange, and EditingCommands through SDK-built BAML." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Document">
                <FlowDocumentScrollViewer Margin="0,14,0,0">
                    <FlowDocument PagePadding="12">
                        <Paragraph FontSize="18" FontWeight="SemiBold">
                            Managed WPF document content
                        </Paragraph>
                        <Paragraph>
                            This document is compiled as normal WPF XAML through the ProGPU SDK. It is intentionally simple
                            so it can be used as a fast manual smoke app while rendering, input, layout, and packaging mature.
                        </Paragraph>
                        <List>
                            <ListItem><Paragraph>Application and window lifecycle</Paragraph></ListItem>
                            <ListItem><Paragraph>Bindings, commands, and item templates</Paragraph></ListItem>
                            <ListItem><Paragraph>Basic document object graph reuse</Paragraph></ListItem>
                        </List>
                    </FlowDocument>
                </FlowDocumentScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock
                    x:Name="CommandStatusText"
                    Text="{Binding CommandStatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
