<Window
    x:Class="ProGPU.Wpf.MvpApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="RootWindow"
    Title="ProGPU WPF MVP"
    Width="760"
    Height="560"
    MinWidth="560"
    MinHeight="420">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="ProGPU WPF MVP" />
            <TextBlock
                Margin="0,4,0,14"
                Foreground="#5B6472"
                Text="A no-source-change SDK app using regular WPF XAML, bindings, commands, controls, and documents." />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Controls">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,14"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="NameTextBox"
                                VerticalContentAlignment="Center"
                                Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Command="{Binding AddItemCommand}"
                                Content="Add item" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ListBox
                            x:Name="ItemsList"
                            ItemsSource="{Binding Items}"
                            SelectedItem="{Binding SelectedItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="120"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Foreground="#5B6472"
                                            Text="{Binding Category, StringFormat=Category: {0}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,12,0,6"
                            FontWeight="SemiBold"
                            Text="Tabular view" />

                        <DataGrid
                            x:Name="ItemsDataGrid"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Items}"
                            SelectedItem="{Binding SelectedItem}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Binding="{Binding Name}"
                                    Header="Name" />
                                <DataGridTextColumn
                                    Binding="{Binding Category}"
                                    Header="Category" />
                                <DataGridCheckBoxColumn
                                    Binding="{Binding IsActive}"
                                    Header="Active" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="18,0,0,0">
                        <CheckBox
                            x:Name="EnabledCheckBox"
                            Margin="0,0,0,12"
                            Content="Enable actions"
                            IsChecked="{Binding ActionsEnabled}" />
                        <TextBlock Text="Progress" />
                        <Slider
                            x:Name="ProgressSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding Progress}" />
                        <ProgressBar
                            Height="16"
                            Margin="0,4,0,12"
                            Maximum="100"
                            Value="{Binding Progress}" />
                        <ComboBox
                            x:Name="CategoryCombo"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}" />
                        <Button
                            Margin="0,14,0,0"
                            Command="{Binding ResetCommand}"
                            Content="Reset" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Document">
                <FlowDocumentScrollViewer Margin="0,14,0,0">
                    <FlowDocument PagePadding="12">
                        <Paragraph FontSize="18" FontWeight="SemiBold">
                            Managed WPF document content
                        </Paragraph>
                        <Paragraph>
                            This document is compiled as normal WPF XAML through the ProGPU SDK. It is intentionally simple
                            so it can be used as a fast manual smoke app while rendering, input, layout, and packaging mature.
                        </Paragraph>
                        <List>
                            <ListItem><Paragraph>Application and window lifecycle</Paragraph></ListItem>
                            <ListItem><Paragraph>Bindings, commands, and item templates</Paragraph></ListItem>
                            <ListItem><Paragraph>Basic document object graph reuse</Paragraph></ListItem>
                        </List>
                    </FlowDocument>
                </FlowDocumentScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
