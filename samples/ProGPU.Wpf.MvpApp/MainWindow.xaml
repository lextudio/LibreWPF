<Window
    x:Class="ProGPU.Wpf.MvpApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:local="clr-namespace:ProGPU.Wpf.MvpApp"
    x:Name="RootWindow"
    Title="ProGPU WPF MVP"
    Width="760"
    Height="560"
    MinWidth="560"
    MinHeight="420">
    <Window.CommandBindings>
        <CommandBinding
            Command="{x:Static local:MainWindow.RefreshStatusCommand}"
            CanExecute="OnRefreshStatusCommandCanExecute"
            Executed="OnRefreshStatusCommandExecuted" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding
            Key="R"
            Modifiers="Control"
            Command="{x:Static local:MainWindow.RefreshStatusCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <local:MvpActiveTextConverter x:Key="MvpActiveTextConverter" />
        <local:MvpItemSummaryConverter x:Key="MvpItemSummaryConverter" />
        <DataTemplate
            x:Key="MvpActiveItemTemplate"
            DataType="{x:Type local:MvpItem}">
            <Border
                MinWidth="150"
                Padding="8"
                Background="#E7F5EE">
                <StackPanel>
                    <TextBlock
                        x:Name="SelectorActiveNameText"
                        FontWeight="SemiBold"
                        Text="{Binding Name}" />
                    <TextBlock
                        Foreground="#236B46"
                        Text="Active item" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate
            x:Key="MvpInactiveItemTemplate"
            DataType="{x:Type local:MvpItem}">
            <Border
                MinWidth="150"
                Padding="8"
                Background="#F2F3F6">
                <StackPanel>
                    <TextBlock
                        x:Name="SelectorInactiveNameText"
                        FontWeight="SemiBold"
                        Text="{Binding Name}" />
                    <TextBlock
                        Foreground="#5B6472"
                        Text="Inactive item" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <local:MvpItemTemplateSelector
            x:Key="MvpItemTemplateSelector"
            ActiveTemplate="{StaticResource MvpActiveItemTemplate}"
            InactiveTemplate="{StaticResource MvpInactiveItemTemplate}" />
        <ControlTemplate x:Key="MvpValidationErrorTemplate">
            <StackPanel>
                <AdornedElementPlaceholder x:Name="MvpValidationErrorPlaceholder" />
                <TextBlock
                    x:Name="MvpValidationErrorText"
                    Margin="0,4,0,0"
                    Foreground="#B42318"
                    Text="{Binding [0].ErrorContent}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ControlTemplate>
        <Style
            x:Key="MvpSelectorItemContainerStyle"
            TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Tag" Value="ActiveContainer" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <CollectionViewSource
            x:Key="ItemsViewSource"
            Filter="OnItemsViewSourceFilter">
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription
                    Direction="Ascending"
                    PropertyName="Category" />
                <componentModel:SortDescription
                    Direction="Ascending"
                    PropertyName="Name" />
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <HierarchicalDataTemplate
            x:Key="MvpNodeTemplate"
            ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    MinWidth="130"
                    FontWeight="SemiBold"
                    Text="{Binding Name}" />
                <TextBlock
                    Foreground="#5B6472"
                    Text="{Binding Kind, StringFormat=Kind: {0}}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Menu
                x:Name="MainMenu"
                Margin="0,0,0,10">
                <MenuItem
                    x:Name="FileMenuItem"
                    Header="_File">
                    <MenuItem
                        x:Name="AddMenuItem"
                        Command="{Binding AddItemCommand}"
                        Header="_Add item"
                        InputGestureText="Ctrl+N" />
                    <Separator />
                    <MenuItem
                        x:Name="ResetMenuItem"
                        Command="{Binding ResetCommand}"
                        Header="_Reset" />
                </MenuItem>
                <MenuItem
                    x:Name="ViewMenuItem"
                    Header="_View">
                    <MenuItem
                        x:Name="ActionsEnabledMenuItem"
                        Header="_Enable actions"
                        IsCheckable="True"
                        IsChecked="{Binding ActionsEnabled}" />
                    <Separator />
                    <MenuItem
                        x:Name="RefreshMenuItem"
                        Command="{x:Static local:MainWindow.RefreshStatusCommand}"
                        Header="_Refresh status"
                        InputGestureText="Ctrl+R" />
                </MenuItem>
            </Menu>
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="ProGPU WPF MVP" />
            <TextBlock
                Margin="0,4,0,14"
                Foreground="#5B6472"
                Text="A no-source-change SDK app using regular WPF XAML, bindings, commands, controls, and documents." />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Controls">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,14"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="NameTextBox"
                                VerticalContentAlignment="Center"
                                Text="{Binding NewItemName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Command="{Binding AddItemCommand}"
                                Content="Add item" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ListBox
                            x:Name="ItemsList"
                            ItemsSource="{Binding Items}"
                            SelectedItem="{Binding SelectedItem}">
                            <ListBox.ContextMenu>
                                <ContextMenu
                                    x:Name="ItemsContextMenu"
                                    DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem
                                        x:Name="ContextAddMenuItem"
                                        Command="{Binding AddItemCommand}"
                                        Header="_Add item" />
                                    <MenuItem
                                        x:Name="ContextRefreshMenuItem"
                                        Command="{x:Static local:MainWindow.RefreshStatusCommand}"
                                        CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                        Header="_Refresh status" />
                                    <Separator />
                                    <MenuItem
                                        x:Name="ContextActionsEnabledMenuItem"
                                        Header="_Enable actions"
                                        IsCheckable="True"
                                        IsChecked="{Binding ActionsEnabled}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            MinWidth="120"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            Foreground="#5B6472"
                                            Text="{Binding Category, StringFormat=Category: {0}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,12,0,6"
                            FontWeight="SemiBold"
                            Text="Tabular view" />

                        <DataGrid
                            x:Name="ItemsDataGrid"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Items}"
                            SelectedItem="{Binding SelectedItem}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Binding="{Binding Name}"
                                    Header="Name" />
                                <DataGridTextColumn
                                    Binding="{Binding Category}"
                                    Header="Category" />
                                <DataGridCheckBoxColumn
                                    Binding="{Binding IsActive}"
                                    Header="Active" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="18,0,0,0">
                        <CheckBox
                            x:Name="EnabledCheckBox"
                            Margin="0,0,0,12"
                            Content="Enable actions"
                            IsChecked="{Binding ActionsEnabled}" />
                        <TextBlock Text="Progress" />
                        <Slider
                            x:Name="ProgressSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding Progress}" />
                        <ProgressBar
                            Height="16"
                            Margin="0,4,0,12"
                            Maximum="100"
                            Value="{Binding Progress}" />
                        <ComboBox
                            x:Name="CategoryCombo"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}" />
                        <Button
                            Margin="0,14,0,0"
                            Command="{Binding ResetCommand}"
                            Content="Reset" />
                        <local:SummaryPanel
                            x:Name="SummaryPanel"
                            Margin="0,18,0,0" />
                        <TextBlock
                            Margin="0,18,0,4"
                            FontWeight="SemiBold"
                            Text="Selected summary" />
                        <TextBlock
                            x:Name="SelectedItemSummaryText"
                            TextWrapping="Wrap">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource MvpItemSummaryConverter}">
                                    <Binding Path="SelectedItem.Name" />
                                    <Binding Path="SelectedItem.Category" />
                                    <Binding Path="Progress" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Views">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <CheckBox
                        x:Name="ActiveOnlyCheckBox"
                        Margin="0,0,0,12"
                        Checked="OnActiveOnlyFilterChanged"
                        Content="Show active items only"
                        IsChecked="{Binding ShowActiveOnly}"
                        Unchecked="OnActiveOnlyFilterChanged" />

                    <ListBox
                        x:Name="GroupedItemsList"
                        Grid.Row="1"
                        ItemsSource="{Binding Source={StaticResource ItemsViewSource}}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,8,0,4"
                                            Padding="6,3"
                                            Background="{DynamicResource MvpPanelBrush}">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        MinWidth="120"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        x:Name="GroupedItemActiveText"
                                        Foreground="#5B6472"
                                        Text="{Binding IsActive, Converter={StaticResource MvpActiveTextConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Collection view" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="CollectionViewSource sorting, grouping, filtering, and group header templates are loaded from compiled WPF XAML." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Explorer">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TreeView
                        x:Name="NodesTreeView"
                        ItemTemplate="{StaticResource MvpNodeTemplate}"
                        ItemsSource="{Binding Nodes}" />

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Hierarchy" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="TreeView and HierarchicalDataTemplate are loaded from normal WPF XAML through the ProGPU SDK." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Templates">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ContentControl
                            x:Name="SelectedItemContent"
                            Content="{Binding SelectedItem}"
                            ContentTemplate="{StaticResource SelectedItemTemplate}" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="0,14,0,8"
                            FontWeight="SemiBold"
                            Text="Template selector list" />

                        <ListBox
                            x:Name="SelectorItemsList"
                            Grid.Row="2"
                            ItemContainerStyle="{StaticResource MvpSelectorItemContainerStyle}"
                            ItemTemplateSelector="{StaticResource MvpItemTemplateSelector}"
                            ItemsSource="{Binding Items}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Grid>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Resource template" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="The selected item view is generated by a compiled DataTemplate, while the list below uses a DataTemplateSelector, ItemContainerStyle, and ItemsPanelTemplate." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Themes">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="ControlTemplate style" />
                        <Button
                            x:Name="TemplateButton"
                            Content="Templated action"
                            Style="{StaticResource MvpTemplateButtonStyle}" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Theme template" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="The button is styled through a compiled ControlTemplate, TemplateBinding, named parts, and a property trigger." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Validation">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Validated form field" />
                        <TextBox
                            x:Name="ValidationTextBox"
                            Validation.ErrorTemplate="{StaticResource MvpValidationErrorTemplate}">
                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    NotifyOnValidationError="True"
                                    Path="ValidationText"
                                    UpdateSourceTrigger="Explicit">
                                    <Binding.ValidationRules>
                                        <local:MvpNonEmptyValidationRule />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock
                            x:Name="ValidationEchoText"
                            Margin="0,14,0,0"
                            Text="{Binding ValidationText, StringFormat=Current: {0}}"
                            TextWrapping="Wrap" />
                        <Separator Margin="0,18,0,14" />
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Grouped commit validation" />
                        <StackPanel x:Name="BindingGroupPanel">
                            <StackPanel.BindingGroup>
                                <BindingGroup Name="MvpBindingGroup">
                                    <BindingGroup.ValidationRules>
                                        <local:MvpBindingGroupValidationRule
                                            FirstProperty="BindingGroupFirstName"
                                            RequiredPrefix="group:"
                                            SecondProperty="BindingGroupLastName" />
                                    </BindingGroup.ValidationRules>
                                </BindingGroup>
                            </StackPanel.BindingGroup>
                            <TextBox
                                x:Name="BindingGroupFirstBox"
                                Text="{Binding BindingGroupFirstName, UpdateSourceTrigger=Explicit}" />
                            <TextBox
                                x:Name="BindingGroupLastBox"
                                Margin="0,8,0,0"
                                Text="{Binding BindingGroupLastName, UpdateSourceTrigger=Explicit}" />
                            <Button
                                x:Name="BindingGroupCommitButton"
                                Margin="0,10,0,0"
                                Click="OnBindingGroupCommitClick"
                                Content="Commit grouped edit" />
                            <TextBlock
                                x:Name="BindingGroupStatusText"
                                Margin="0,10,0,0"
                                Text="{Binding BindingGroupStatus}" />
                            <TextBlock
                                x:Name="BindingGroupFirstEchoText"
                                Margin="0,10,0,0"
                                Text="{Binding BindingGroupFirstName, StringFormat=First: {0}}" />
                            <TextBlock
                                x:Name="BindingGroupLastEchoText"
                                Text="{Binding BindingGroupLastName, StringFormat=Last: {0}}" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Binding validation" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="This tab uses a normal WPF ValidationRule, explicit source updates, and a compiled Validation.ErrorTemplate." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Animation">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontWeight="SemiBold"
                            Text="Storyboard triggers" />
                        <TextBlock
                            x:Name="LoadedStoryboardText"
                            Opacity="1"
                            Text="Loaded storyboard target">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="LoadedStoryboardText"
                                                Storyboard.TargetProperty="Opacity"
                                                Duration="0:0:0"
                                                To="0.42" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                        <Button
                            x:Name="ClickStoryboardButton"
                            Margin="0,14,0,0"
                            Content="Animate click target"
                            Opacity="1">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.Click">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ClickStoryboardButton"
                                                Storyboard.TargetProperty="Opacity"
                                                Duration="0:0:0"
                                                To="0.58" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="12"
                        Background="{DynamicResource MvpPanelBrush}">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="EventTrigger clocks" />
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Text="This tab uses compiled EventTrigger and BeginStoryboard timelines loaded through the ProGPU WPF SDK." />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Navigation">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Frame
                        x:Name="NavigationFrame"
                        NavigationUIVisibility="Visible"
                        Source="OverviewPage.xaml" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="18,0,0,0">
                        <Button
                            x:Name="OverviewNavigationButton"
                            Content="Overview"
                            Click="OnOverviewNavigationClick" />
                        <Button
                            x:Name="DetailsNavigationButton"
                            Content="Details"
                            Click="OnDetailsNavigationClick" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Document">
                <FlowDocumentScrollViewer Margin="0,14,0,0">
                    <FlowDocument PagePadding="12">
                        <Paragraph FontSize="18" FontWeight="SemiBold">
                            Managed WPF document content
                        </Paragraph>
                        <Paragraph>
                            This document is compiled as normal WPF XAML through the ProGPU SDK. It is intentionally simple
                            so it can be used as a fast manual smoke app while rendering, input, layout, and packaging mature.
                        </Paragraph>
                        <List>
                            <ListItem><Paragraph>Application and window lifecycle</Paragraph></ListItem>
                            <ListItem><Paragraph>Bindings, commands, and item templates</Paragraph></ListItem>
                            <ListItem><Paragraph>Basic document object graph reuse</Paragraph></ListItem>
                        </List>
                    </FlowDocument>
                </FlowDocumentScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock
                    x:Name="CommandStatusText"
                    Text="{Binding CommandStatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
