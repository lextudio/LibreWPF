<Project Sdk="LibreWPF.Sdk/11.0.0-dev">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(ProGpuWpfSdkSampleTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/MvpResource.txt" />
    <Content Include="Assets/MvpContent.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets/MvpContent.txt</TargetPath>
    </Content>
  </ItemGroup>
</Project>
