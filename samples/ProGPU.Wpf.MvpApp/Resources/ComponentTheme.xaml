<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="MvpComponentPackText">Component pack dictionary ready</sys:String>
    <SolidColorBrush x:Key="MvpComponentPackBrush" Color="#6B4E23" />
    <Style x:Key="MvpComponentPackTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource MvpComponentPackBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
