<UserControl
    x:Class="ProGPU.Wpf.MvpApp.SummaryPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12"
        Background="{DynamicResource MvpPanelBrush}">
        <StackPanel>
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Text="Selection summary" />
            <TextBlock
                x:Name="SummaryNameText"
                Margin="0,8,0,0"
                Text="{Binding SelectedItem.Name, StringFormat=Name: {0}}" />
            <TextBlock
                x:Name="SummaryCategoryText"
                Margin="0,4,0,0"
                Text="{Binding SelectedItem.Category, StringFormat=Category: {0}}" />
            <TextBlock
                x:Name="SummaryProgressText"
                Margin="0,4,0,0"
                Text="{Binding Progress, StringFormat=Progress: {0:0}%}" />
        </StackPanel>
    </Border>
</UserControl>
