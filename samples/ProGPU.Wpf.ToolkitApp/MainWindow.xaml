<Window x:Class="ProGPU.Wpf.ToolkitApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Private.CoreLib"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:xcad="http://schemas.xceed.com/wpf/xaml/avalondock"
        Title="ProGPU WPF Toolkit + AvalonDock"
        Width="980"
        Height="640"
        MinWidth="720"
        MinHeight="460"
        Background="#F6F8FA">
  <Window.Resources>
    <DrawingImage x:Key="DocumentIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FFFFFF"
                           Geometry="M2,1 L10,1 L14,5 L14,15 L2,15 Z" />
          <GeometryDrawing Brush="#5B8DEF"
                           Geometry="M10,1 L14,5 L10,5 Z M4,7 L12,7 L12,8 L4,8 Z M4,10 L12,10 L12,11 L4,11 Z" />
          <GeometryDrawing Brush="#2F5DA8"
                           Geometry="M2,1 L10,1 L14,5 L14,15 L2,15 Z M3,2 L3,14 L13,14 L13,6 L9,6 L9,2 Z" />
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="ToolIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#20A67A"
                           Geometry="M2,3 L14,3 L14,13 L2,13 Z" />
          <GeometryDrawing Brush="#E7FFF7"
                           Geometry="M4,5 L12,5 L12,6 L4,6 Z M4,8 L10,8 L10,9 L4,9 Z M4,11 L8,11 L8,12 L4,12 Z" />
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PanelHeaderText" TargetType="{x:Type TextBlock}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#243746" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Window.Resources>

  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top"
            Background="{StaticResource ToolkitAccentBrush}"
            Padding="12,8">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal">
          <Button x:Name="AddDocumentButton"
                  MinWidth="104"
                  Margin="0,0,6,0"
                  Padding="10,4"
                  Content="Add document"
                  Click="AddDocumentButton_Click" />
          <Button x:Name="ActivateEditorButton"
                  MinWidth="104"
                  Margin="0,0,6,0"
                  Padding="10,4"
                  Content="Activate editor"
                  Click="ActivateEditorButton_Click" />
          <Button x:Name="ToggleEditorFloatButton"
                  MinWidth="104"
                  Margin="0,0,6,0"
                  Padding="10,4"
                  Content="Float editor"
                  Click="ToggleEditorFloatButton_Click" />
          <Button x:Name="TogglePropertyPaneButton"
                  MinWidth="112"
                  Margin="0,0,6,0"
                  Padding="10,4"
                  Content="Toggle properties"
                  Click="TogglePropertyPaneButton_Click" />
          <Button x:Name="ToggleActivityAutoHideButton"
                  MinWidth="120"
                  Margin="0,0,6,0"
                  Padding="10,4"
                  Content="Auto-hide activity"
                  Click="ToggleActivityAutoHideButton_Click" />
          <Button x:Name="ToggleAgendaAutoHideButton"
                  MinWidth="104"
                  Margin="0,0,6,0"
                  Padding="10,4"
                  Content="Dock agenda"
                  Click="ToggleAgendaAutoHideButton_Click" />
          <Button x:Name="SerializeLayoutButton"
                  MinWidth="96"
                  Padding="10,4"
                  Content="Save layout"
                  Click="SerializeLayoutButton_Click" />
        </StackPanel>
        <TextBlock Foreground="White"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="Extended WPF Toolkit and AvalonDock through ProGPU.Wpf.Sdk"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusText"
                   Text="{Binding Status}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding DocumentCount, StringFormat=Documents: {0}}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="LastFocusedDocumentText"
                   Text="{Binding ElementName=DockLayoutRoot, Path=LastFocusedDocument.Title, StringFormat=Focused: {0}, TargetNullValue=Focused: none}" />
      </StatusBarItem>
    </StatusBar>

    <xcad:DockingManager x:Name="DockManager"
                         AllowMixedOrientation="True"
                         BorderBrush="#708090"
                         BorderThickness="1">
      <xcad:DockingManager.DocumentHeaderTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <Image Source="{Binding IconSource}"
                   Width="14"
                   Height="14"
                   Margin="0,0,4,0" />
            <TextBlock Text="{Binding Title}" />
          </StackPanel>
        </DataTemplate>
      </xcad:DockingManager.DocumentHeaderTemplate>
      <xcad:DockingManager.Theme>
        <xcad:AeroTheme />
      </xcad:DockingManager.Theme>

      <xcad:LayoutRoot x:Name="DockLayoutRoot">
        <xcad:LayoutPanel Orientation="Horizontal">
          <xcad:LayoutAnchorablePane DockWidth="260">
            <xcad:LayoutAnchorable x:Name="ToolkitPane"
                                   ContentId="toolkit-controls"
                                   Title="Toolkit"
                                   IconSource="{StaticResource ToolIcon}"
                                   CanClose="False"
                                   CanHide="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                  <TextBlock Style="{StaticResource PanelHeaderText}"
                             Text="Toolkit controls" />

                  <TextBlock Text="IntegerUpDown" />
                  <xctk:IntegerUpDown x:Name="PriorityEditor"
                                      Minimum="0"
                                      Maximum="10"
                                      Increment="1"
                                      Value="{Binding Priority}"
                                      Margin="0,4,0,12" />

                  <TextBlock Text="WatermarkTextBox" />
                  <xctk:WatermarkTextBox x:Name="FilterTextBox"
                                         Watermark="Filter documents"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4,0,12" />

                  <TextBlock Text="WatermarkComboBox" />
                  <xctk:WatermarkComboBox x:Name="OwnerComboBox"
                                          Watermark="Owner"
                                          ItemsSource="{Binding Owners}"
                                          SelectedItem="{Binding SelectedOwner}"
                                          Margin="0,4,0,12" />

                  <TextBlock Text="RangeSlider" />
                  <xctk:RangeSlider x:Name="PriorityRangeSlider"
                                    Minimum="0"
                                    Maximum="10"
                                    LowerValue="{Binding PriorityRangeStart}"
                                    HigherValue="{Binding PriorityRangeEnd}"
                                    Margin="0,4,0,12" />

                  <TextBlock Text="DateTimePicker" />
                  <xctk:DateTimePicker x:Name="DueDatePicker"
                                       Value="{Binding DueDate}"
                                       Format="Custom"
                                       FormatString="yyyy-MM-dd HH:mm"
                                       Margin="0,4,0,12" />

                  <TextBlock Text="TimePicker" />
                  <xctk:TimePicker x:Name="ReminderTimePicker"
                                   Value="{Binding ReminderTime}"
                                   Format="Custom"
                                   FormatString="HH:mm"
                                   Margin="0,4,0,12" />

                  <TextBlock Text="MaskedTextBox" />
                  <xctk:MaskedTextBox x:Name="ReferenceMaskTextBox"
                                      Mask="LL-0000"
                                      Text="{Binding ReferenceCode, UpdateSourceTrigger=PropertyChanged}"
                                      IncludeLiteralsInValue="True"
                                      IncludePromptInValue="False"
                                      Margin="0,4,0,12" />

                  <TextBlock Text="CheckComboBox" />
                  <xctk:CheckComboBox x:Name="CategoryPicker"
                                      ItemsSource="{Binding Categories}"
                                      SelectedItemsOverride="{Binding SelectedCategories}"
                                      Margin="0,4,0,12" />

                  <TextBlock Text="CheckListBox" />
                  <xctk:CheckListBox x:Name="FlagListBox"
                                     ItemsSource="{Binding Flags}"
                                     SelectedItemsOverride="{Binding SelectedFlags}"
                                     Height="88"
                                     Margin="0,4,0,12" />

                  <TextBlock Text="ColorPicker" />
                  <xctk:ColorPicker x:Name="AccentColorPicker"
                                    SelectedColor="{Binding AccentColor}"
                                    DisplayColorAndName="True"
                                    ShowStandardColors="True"
                                    ShowAvailableColors="True"
                                    ShowRecentColors="True"
                                    Margin="0,4,0,12" />

                  <TextBlock Text="CalculatorUpDown" />
                  <xctk:CalculatorUpDown x:Name="EstimateEditor"
                                         Minimum="0"
                                         Maximum="100"
                                         Increment="0.25"
                                         FormatString="F2"
                                         Value="{Binding Estimate}"
                                         Margin="0,4,0,12" />

                  <TextBlock Text="DropDownButton" />
                  <xctk:DropDownButton x:Name="ActionDropDownButton"
                                       Content="Document actions"
                                       Margin="0,4,0,12">
                    <xctk:DropDownButton.DropDownContent>
                      <StackPanel x:Name="ActionDropDownContentRoot"
                                  MinWidth="180"
                                  Margin="8">
                        <Button x:Name="MarkReviewedButton"
                                Content="Mark reviewed"
                                Padding="8,4"
                                Click="MarkReviewedButton_Click" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#5E6A73"
                                   Text="{Binding SelectedDocument.Title, StringFormat=Selected: {0}}" />
                      </StackPanel>
                    </xctk:DropDownButton.DropDownContent>
                  </xctk:DropDownButton>

                  <TextBlock Text="SplitButton" />
                  <xctk:SplitButton x:Name="SplitActionButton"
                                    Content="Apply owner"
                                    Click="SplitActionButton_Click"
                                    Margin="0,4,0,12">
                    <xctk:SplitButton.DropDownContent>
                      <StackPanel x:Name="SplitActionDropDownContentRoot"
                                  MinWidth="180"
                                  Margin="8">
                        <ListBox x:Name="OwnerPickerList"
                                 ItemsSource="{Binding Owners}"
                                 SelectedItem="{Binding SelectedOwner}"
                                 Height="72" />
                        <Button x:Name="AssignSdkOwnerButton"
                                Content="Assign SDK owner"
                                Margin="0,8,0,0"
                                Padding="8,4"
                                Click="AssignSdkOwnerButton_Click" />
                      </StackPanel>
                    </xctk:SplitButton.DropDownContent>
                  </xctk:SplitButton>

                  <TextBlock Text="Wizard" />
                  <xctk:Wizard x:Name="ToolkitWizard"
                               Height="220"
                               Margin="0,4,0,12"
                               BackButtonContent="Back"
                               NextButtonContent="Next"
                               FinishButtonContent="Finish"
                               CancelButtonContent="Cancel"
                               FinishButtonClosesWindow="False"
                               CancelButtonClosesWindow="False"
                               PageChanged="ToolkitWizard_PageChanged"
                               Finish="ToolkitWizard_Finish"
                               Cancel="ToolkitWizard_Cancel">
                    <xctk:WizardPage x:Name="WizardScopePage"
                                     Title="Scope"
                                     Description="Choose owner and priority range"
                                     PageType="Interior"
                                     CanFinish="False">
                      <StackPanel Margin="8">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Selection" />
                        <TextBlock Text="{Binding SelectedOwner, StringFormat=Owner: {0}}" />
                        <TextBlock Text="{Binding PriorityRangeStart, StringFormat=Priority from: {0:F1}}" />
                        <TextBlock Text="{Binding PriorityRangeEnd, StringFormat=Priority to: {0:F1}}" />
                      </StackPanel>
                    </xctk:WizardPage>
                    <xctk:WizardPage x:Name="WizardReviewPage"
                                     Title="Review"
                                     Description="Confirm Toolkit state"
                                     PageType="Interior"
                                     CanFinish="True">
                      <StackPanel Margin="8">
                        <TextBlock FontWeight="SemiBold"
                                   Text="Ready" />
                        <TextBlock Text="Wizard page state is handled by Xceed and WPF." />
                        <TextBlock Text="{Binding WizardStatus}" />
                      </StackPanel>
                    </xctk:WizardPage>
                  </xctk:Wizard>

                  <TextBlock Text="RichTextBox" />
                  <xctk:RichTextBox x:Name="ToolkitRichTextBox"
                                    Height="96"
                                    Text="{Binding RichNotes, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,4,0,12">
                    <xctk:RichTextBox.TextFormatter>
                      <xctk:PlainTextFormatter />
                    </xctk:RichTextBox.TextFormatter>
                  </xctk:RichTextBox>

                  <xctk:BusyIndicator x:Name="BusyIndicator"
                                      IsBusy="{Binding IsBusy}"
                                      BusyContent="Refreshing toolkit state"
                                      MinHeight="72">
                    <Border Background="{StaticResource ToolkitSubtleBrush}"
                            Padding="10">
                      <TextBlock Text="BusyIndicator content remains interactive when IsBusy is false." />
                    </Border>
                  </xctk:BusyIndicator>
                </StackPanel>
              </ScrollViewer>
            </xcad:LayoutAnchorable>
          </xcad:LayoutAnchorablePane>

          <xcad:LayoutDocumentPaneGroup>
            <xcad:LayoutDocumentPane x:Name="DocumentPane">
              <xcad:LayoutDocument ContentId="overview"
                                   Title="Overview"
                                   x:Name="OverviewDocument"
                                   IconSource="{StaticResource DocumentIcon}"
                                   IsSelected="True">
                <Grid Margin="16">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock FontSize="18"
                             FontWeight="SemiBold"
                             Text="AvalonDock document surface" />
                  <ListView x:Name="DocumentList"
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            ItemsSource="{Binding Documents}"
                            SelectedItem="{Binding SelectedDocument}">
                    <ListView.View>
                      <GridView>
                        <GridViewColumn Header="Title"
                                        DisplayMemberBinding="{Binding Title}"
                                        Width="160" />
                        <GridViewColumn Header="Owner"
                                        DisplayMemberBinding="{Binding Owner}"
                                        Width="120" />
                        <GridViewColumn Header="Modified"
                                        DisplayMemberBinding="{Binding Modified}"
                                        Width="150" />
                      </GridView>
                    </ListView.View>
                  </ListView>
                </Grid>
              </xcad:LayoutDocument>

              <xcad:LayoutDocument x:Name="EditorDocument"
                                   ContentId="editor"
                                   Title="Editor"
                                   IconSource="{StaticResource DocumentIcon}">
                <Grid Margin="16">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock FontSize="18"
                             FontWeight="SemiBold"
                             Text="{Binding SelectedDocument.Title}" />
                  <TextBox x:Name="EditorTextBox"
                           Grid.Row="1"
                           Margin="0,12,0,0"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           Text="{Binding SelectedDocument.Body, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
              </xcad:LayoutDocument>
            </xcad:LayoutDocumentPane>
          </xcad:LayoutDocumentPaneGroup>

          <xcad:LayoutAnchorablePaneGroup DockWidth="260">
            <xcad:LayoutAnchorablePane>
              <xcad:LayoutAnchorable x:Name="PropertyPane"
                                     ContentId="property-grid"
                                     Title="PropertyGrid"
                                     IconSource="{StaticResource ToolIcon}"
                                     CanClose="False">
                <xctk:PropertyGrid x:Name="DocumentPropertyGrid"
                                   Margin="8"
                                   SelectedObject="{Binding SelectedDocument}"
                                   AutoGenerateProperties="True" />
              </xcad:LayoutAnchorable>

              <xcad:LayoutAnchorable x:Name="ActivityPane"
                                     ContentId="activity"
                                     Title="Activity"
                                     IconSource="{StaticResource ToolIcon}"
                                     AutoHideWidth="260">
                <ListBox x:Name="ActivityList"
                         ItemsSource="{Binding Activity}"
                         Margin="8">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type sys:String}">
                      <TextBlock Text="{Binding}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </xcad:LayoutAnchorable>
            </xcad:LayoutAnchorablePane>
          </xcad:LayoutAnchorablePaneGroup>
        </xcad:LayoutPanel>
        <xcad:LayoutRoot.LeftSide>
          <xcad:LayoutAnchorSide>
            <xcad:LayoutAnchorGroup x:Name="LeftAutoHideGroup">
              <xcad:LayoutAnchorable x:Name="AgendaPane"
                                     ContentId="agenda"
                                     Title="Agenda"
                                     IconSource="{StaticResource ToolIcon}"
                                     AutoHideWidth="240">
                <StackPanel Margin="12">
                  <TextBlock Style="{StaticResource PanelHeaderText}"
                             Text="Agenda" />
                  <TextBlock Text="Auto-hidden side content validates AvalonDock anchor sides and restore paths." />
                </StackPanel>
              </xcad:LayoutAnchorable>
              <xcad:LayoutAnchorable x:Name="ContactsPane"
                                     ContentId="contacts"
                                     Title="Contacts"
                                     IconSource="{StaticResource ToolIcon}"
                                     AutoHideWidth="240">
                <ListBox Margin="8">
                  <sys:String>Toolkit team</sys:String>
                  <sys:String>Rendering team</sys:String>
                  <sys:String>SDK team</sys:String>
                </ListBox>
              </xcad:LayoutAnchorable>
            </xcad:LayoutAnchorGroup>
          </xcad:LayoutAnchorSide>
        </xcad:LayoutRoot.LeftSide>
      </xcad:LayoutRoot>
    </xcad:DockingManager>
  </DockPanel>
</Window>
