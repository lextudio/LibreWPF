<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the managed System.Printing (queues, servers, unimplemented-member behaviour) over a fake backend. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Microsoft.DotNet.Wpf\src\System.Printing\managed\System.Printing.Managed.csproj" />
    <ProjectReference Include="..\..\external\PrintingTools\src\PrintingTools.Core\PrintingTools.Core.csproj" />
  </ItemGroup>

  <!-- Several projects in the reference closure produce a System.Printing.dll (stubs, reference assembly); make sure the
       managed implementation is the one next to the tests. -->
  <Target Name="UseManagedSystemPrinting" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\artifacts\bin\System.Printing.Managed\$(Configuration)\$(TargetFramework)\System.Printing.dll"
          DestinationFolder="$(OutDir)" />
  </Target>
</Project>
