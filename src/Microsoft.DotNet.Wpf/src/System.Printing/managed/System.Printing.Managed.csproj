<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Managed System.Printing: the public API of ../ref/System.Printing.cs over PrintingTools (Win32 spooler on
    Windows, CUPS/IPP elsewhere). Replaces the C++/CLI project, which stays behind LibreWpfUseCppCli=true.
    The output lands in artifacts/bin/System.Printing.Managed (named by the project; packaging reads it from there). Surface.g.cs is generated by generate-surface.py; unimplemented members throw PlatformNotSupportedException.
    It references what the C++/CLI project references (the PresentationFramework impl-cycle assembly and
    ReachFramework: PrintTicket, PrintCapabilities, PrintQueueException ...).
  -->
  <PropertyGroup>
    <AssemblyName>System.Printing</AssemblyName>
    <Nullable>annotations</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PrintingToolsDir>$(MSBuildThisFileDirectory)../../../../../external/PrintingTools/src/</PrintingToolsDir>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Platforms>AnyCPU</Platforms>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(PrintingToolsDir)PrintingTools.Core/PrintingTools.Core.csproj" Private="true" />
    <ProjectReference Include="$(PrintingToolsDir)PrintingTools.Windows/PrintingTools.Windows.csproj" Private="true" />
    <ProjectReference Include="$(PrintingToolsDir)PrintingTools.Cups/PrintingTools.Cups.csproj" Private="true" />
    <ProjectReference Include="$(WpfSourceDir)PresentationCore\ref\PresentationCore-ref.csproj" />
    <ProjectReference Include="$(WpfSourceDir)WindowsBase\ref\WindowsBase-ref.csproj" />
    <ProjectReference Include="$(WpfSourceDir)System.Xaml\ref\System.Xaml-ref.csproj" />
    <!-- The same references the C++/CLI project has (System.Printing.vcxproj). -->
    <ProjectReference Include="$(WpfCycleBreakersDir)PresentationFramework\PresentationFramework-System.Printing-impl-cycle.csproj" />
    <ProjectReference Include="$(WpfSourceDir)ReachFramework\ReachFramework.csproj" />
  </ItemGroup>

  <!-- Arcade does not copy project-reference outputs; the transport package picks PrintingTools.*.dll up from here. -->
  <Target Name="CopyPrintingToolsNextToSystemPrinting" AfterTargets="Build">
    <ItemGroup>
      <_PrintingToolsAssembly Include="@(_ResolvedProjectReferencePaths)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('PrintingTools.'))" />
    </ItemGroup>
    <Copy SourceFiles="@(_PrintingToolsAssembly)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
