<Window
    x:Class="ProGPU.Wpf.RealXamlCompilerHarness.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ProGPU WPF XAML smoke"
    Width="420"
    Height="260">
    <StackPanel Margin="16">
        <TextBlock
            FontSize="18"
            Foreground="{StaticResource AccentBrush}"
            Text="Real WPF XAML compiler smoke" />
        <TextBox
            x:Name="InputBox"
            Style="{StaticResource SmokeTextBoxStyle}"
            Text="compiled TextBox" />
        <RichTextBox Margin="0,8,0,0">
            <FlowDocument>
                <Paragraph>
                    <Run Text="compiled FlowDocument" />
                </Paragraph>
            </FlowDocument>
        </RichTextBox>
    </StackPanel>
</Window>
