<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="MergedAccentBrush" Color="#6B8F3A" />
    <Thickness x:Key="SmokePanelMargin">0,12,0,0</Thickness>

    <Style x:Key="SmokeListTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
